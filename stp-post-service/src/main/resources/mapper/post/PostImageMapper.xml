<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.summit.stp.post.infrastructure.persistence.mapper.PostImageMapper">
    <select id="findByIds" resultType="com.summit.stp.post.application.vo.PostImageVO">
        SELECT id AS id, post_id AS postId, image_url AS imageUrl, width, height, size, sort_order AS sortOrder
        FROM post_image pi
        WHERE pi.post_id IN
        <foreach item="item" index="index" collection="list" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>
